# OFSD Terminal settings. This file stays on your computer. Never share it.
# After editing, save the file. The app re-reads it on every command (no restart needed).

# 1) Claude. Get a key at https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# 2) SEC EDGAR (used in step 2). SEC requires a name and contact email. Free, no signup.
SEC_USER_AGENT="OFSD Terminal Your Name you@example.com"

# 3) TwitterAPI.io (used in step 3). Get a key at https://twitterapi.io
TWITTERAPI_IO_KEY=

# 4) Discord webhook for your PRIVATE channel (used in step 3).
DISCORD_WEBHOOK_URL=

# Backend port (leave as is unless something else uses it)
PORT=8787
